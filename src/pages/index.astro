---
/**
 * Portfolio home page — Nav, animated Hero (portrait + parallax type), count-up
 * Stats strip, filterable Projects grid, About, and a Footer whose divider
 * is a stacked bar chart of the portfolio itself.
 *
 * Projects are driven by the content collection so adding a new one is a
 * JSON file drop. Category hues come from src/lib/categories.ts and are
 * used identically everywhere (Gestalt similarity).
 */
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_MAP } from '../lib/categories';
import { hero, skills } from '../lib/copy';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

/** Per-category project counts — shown on the filter chips and used as the
 *  segment widths of the footer's stacked-bar divider. */
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.id, projects.filter((p) => p.data.category === c.id).length]),
);
const total = projects.length;

/**
 * Stats strip under the hero: one pinned measure (the portfolio itself) plus
 * a single slot that rotates through real, project-sourced metrics. Any project with a `kpi` field joins the rotation and
 * carries its own category hue, so the pool grows as projects are added.
 */
const kpiPool = projects
  .filter((p) => p.data.kpi)
  .map((p) => ({
    value: p.data.kpi!.value,
    suffix: p.data.kpi!.suffix,
    label: p.data.kpi!.label,
    hueL: CATEGORY_MAP[p.data.category].light,
    hueD: CATEGORY_MAP[p.data.category].dark,
  }));

/** First metric, server-rendered into the slot so no-JS visitors see a real
 *  data point (not a bare "0") before the script takes over the rotation. */
const firstKpi = kpiPool[0];
---

<Base>
  <!-- ─── Navigation ──────────────────────────────────────────────────── -->
  <nav
    class="
      fixed top-0 inset-x-0 z-40
      flex items-center justify-between
      px-6 md:px-12 py-4
      border-b border-day-200 dark:border-night-700
      bg-day-50/85 dark:bg-night-950/85
      backdrop-blur-md
    "
  >
    <!-- Wordmark: a tiny three-bar chart glyph (the site's chart motif in
         miniature) next to the full name -->
    <a href="#top" class="flex items-center gap-2.5 group/logo">
      <svg viewBox="0 0 18 16" class="w-4 h-3.5" aria-hidden="true">
        <rect x="0"  y="8" width="4" height="8" rx="1" class="logo-bar fill-cat-data dark:fill-cat-data-d" />
        <rect x="7"  y="4" width="4" height="12" rx="1" class="logo-bar fill-cat-civic dark:fill-cat-civic-d" />
        <rect x="14" y="0" width="4" height="16" rx="1" class="logo-bar fill-cat-play dark:fill-cat-play-d" />
      </svg>
      <span class="font-display font-bold text-sm tracking-wide text-ink dark:text-frost">
        Matt Snively
      </span>
    </a>

    <div class="flex items-center gap-6">
      <!-- In-page anchor links with animated underlines -->
      <a href="#work" class="nav-link font-mono text-xs tracking-widest uppercase">Work</a>
      <a href="#about" class="nav-link font-mono text-xs tracking-widest uppercase">About</a>

      <!-- Dark / light toggle -->
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="
          w-8 h-8 flex items-center justify-center rounded-full
          text-ink-mute dark:text-frost-mute
          hover:text-ink dark:hover:text-frost
          hover:bg-day-100 dark:hover:bg-night-800
          transition-colors
        "
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" class="w-4 h-4 hidden dark:block" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" class="w-4 h-4 block dark:hidden" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <!--
    Portrait cutout in front of giant type. Layers (back→front): the headline
    words (z-0), the portrait (z-10), the flank text (z-20). On md+ everything
    is absolutely placed in one viewport-tall stage and animated by the script
    below; on mobile it stacks in normal flow. Content is fully visible without
    JS or under reduced motion — the hidden start state is CSS-gated on both.
  -->
  <section id="top" class="hero relative min-h-[100svh] overflow-hidden flex flex-col xl:block">
    <h1
      class="hero-title relative xl:absolute inset-x-0 pt-24 xl:pt-0 z-0 px-6 xl:px-12
             font-display font-bold uppercase text-ink dark:text-frost"
      aria-label={hero.headline.join(' ')}
      data-hero-fade
    >
      {hero.headline.map((word, i) => (
        <span class={`hero-line block ${i % 2 === 0 ? 'xl:text-right' : 'text-right xl:text-left'} ${i === hero.headline.length - 1 ? 'hero-line-accent' : ''}`} data-line={i} aria-hidden="true">
          <span class="hero-line-inner inline-block">
            {[...word].map((ch) => <span class="hero-char inline-block">{ch}</span>)}
          </span>
        </span>
      ))}
    </h1>

    <div class="hero-stage relative xl:absolute xl:inset-x-0 xl:bottom-0 z-10 mt-4 xl:mt-0 flex justify-center pointer-events-none">
      <div class="hero-figure">
        <img
          src="/images/hero/matt-cutout.webp"
          width="1159"
          height="2100"
          alt="Portrait of Matt Snively"
          fetchpriority="high"
          decoding="async"
          class="hero-img block w-auto select-none"
        />
      </div>
    </div>

    <!-- Secondary text: one column bottom-left on wide screens (blurbs, role tags, links) -->
    <div
      class="relative xl:absolute xl:left-12 xl:bottom-14 z-20 px-6 xl:px-0 pt-6 xl:pt-0 xl:max-w-[13rem]"
      data-hero-flank
      data-hero-fade
    >
      <p class="text-base leading-snug text-ink-soft dark:text-frost-soft">
        {hero.leftBlurb}
      </p>
      <p class="mt-3 text-base leading-snug text-ink-soft dark:text-frost-soft">
        {hero.rightBlurb}
      </p>
      <ul class="flex flex-wrap gap-2 mt-5" aria-label="Roles">
        {hero.roles.map((text, i) => {
          const cat = CATEGORIES[[0, 2, 1][i] ?? 0]; // data / apps / civic hues, in role order
          return (
            <li
              class="role-chip inline-flex items-center gap-1.5 font-mono text-[11px] tracking-wide uppercase
                     text-ink-soft dark:text-frost-soft
                     border border-day-200 dark:border-night-700 rounded-full px-3 py-1"
              style={`--hue-l:${cat.light}; --hue-d:${cat.dark};`}
            >
              <span class="w-1.5 h-1.5 rounded-full role-dot" aria-hidden="true"></span>
              {text}
            </li>
          );
        })}
      </ul>
      <div class="flex flex-wrap gap-2 mt-5">
        <a
          href="https://github.com/MattSnively"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-cta font-mono text-xs font-medium tracking-widest uppercase
                 text-white rounded-lg px-5 py-3"
        >
          GitHub ↗
        </a>
        <a
          href="mailto:mattsnively@gmail.com"
          class="font-mono text-xs tracking-widest uppercase rounded-lg px-5 py-3
                 text-ink-soft dark:text-frost-soft
                 border border-day-200 dark:border-night-700
                 hover:border-day-300 dark:hover:border-night-600
                 hover:text-ink dark:hover:text-frost
                 transition-colors"
        >
          Contact →
        </a>
      </div>
      <p class="mt-5 font-mono text-[11px] tracking-[0.2em] uppercase text-ink-mute dark:text-frost-mute">
        Scroll ↓
      </p>
    </div>
  </section>

  <!-- ─── Stats strip ─────────────────────────────────────────────────────
       A pinned measure (the portfolio itself) plus one slot that rotates
       through project-sourced metrics, each in its project's category hue.
       Seeded server-side so no-JS visitors see real numbers; the script
       counts up and starts rotating when the strip scrolls into view. -->
  <section class="reveal px-6 md:px-12 py-10 max-w-6xl mx-auto w-full">
    <div class="kpi-panel grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div
        class="stat-tile stat-featured in rounded-xl p-5"
        style="--hue-l:#2358a0; --hue-d:#4f86c6;"
      >
        <p class="stat-kicker font-mono text-[10px] font-medium tracking-[0.2em] uppercase mb-2">
          Shipped
        </p>
        <p class="gradient-ink font-display text-4xl md:text-5xl font-bold tabular-nums">
          <span class="kpi-pinned-num" data-target={total}>{total}</span>
        </p>
        <span class="stat-rule block h-0.5 w-10 rounded-full my-2.5" aria-hidden="true"></span>
        <p class="text-xs font-mono tracking-wide uppercase text-ink-soft dark:text-frost-soft">
          Projects shipped &amp; counting
        </p>
      </div>

      <div
        class="stat-tile kpi-rotator in rounded-xl p-5
               bg-white dark:bg-night-900
               border border-day-200 dark:border-night-700"
        style={firstKpi ? `--hue-l:${firstKpi.hueL}; --hue-d:${firstKpi.hueD};` : undefined}
      >
        <div class="kpi-rot-content">
          <p class="font-mono text-[10px] tracking-[0.2em] uppercase mb-2 text-ink-mute dark:text-frost-mute">
            Data point
          </p>
          <p class="font-display text-3xl md:text-4xl font-bold text-ink dark:text-frost tabular-nums">
            <span class="kpi-rot-num">{firstKpi ? firstKpi.value.toLocaleString() : '0'}</span><span class="kpi-rot-suffix">{firstKpi ? firstKpi.suffix : ''}</span>
          </p>
          <span class="stat-rule block h-0.5 w-10 rounded-full my-2.5" aria-hidden="true"></span>
          <p class="kpi-rot-label text-xs font-mono tracking-wide uppercase text-ink-mute dark:text-frost-mute">
            {firstKpi ? firstKpi.label : ' '}
          </p>
        </div>
      </div>
    </div>

    <!-- Pool for the rotation script; consumed by the KPI script below -->
    <script type="application/json" id="kpi-pool" is:inline set:html={JSON.stringify(kpiPool)}></script>
  </section>

  <!-- ─── Skills ───────────────────────────────────────────────────────────
       One tall row per skill. The script draws each row's rule, slides its
       title up out of a mask and fades the body in; while scrolling, the row
       nearest the viewport centre stays at full strength and the rest dim.
       Without JS or under reduced motion it is a plain, fully readable list. -->
  <section id="skills" class="skills px-6 md:px-12 py-16 max-w-6xl mx-auto w-full">
    <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-mute dark:text-frost-mute mb-3">
      {skills.label}
    </p>
    <div class="flex items-center gap-5 mb-10">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink dark:text-frost">
        {skills.heading}
      </h2>
      <span class="section-rule flex-1 h-px" aria-hidden="true"></span>
    </div>

    <ol>
      {skills.rows.map((row, i) => (
        <li class="skill-row">
          <span class="skill-rule block h-px" aria-hidden="true"></span>
          <div class="grid grid-cols-1 md:grid-cols-[4.5rem_minmax(0,1.7fr)_minmax(0,1fr)] gap-x-8 gap-y-4 py-8 md:py-12 md:items-start">
            <span class="skill-num font-mono text-xs tracking-widest tabular-nums md:pt-5">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="skill-title font-display font-bold uppercase text-ink dark:text-frost">
              <span class="skill-title-inner inline-block">{row.title}</span>
            </h3>
            <div class="skill-body md:pt-3">
              <p class="text-base md:text-lg leading-snug text-ink-soft dark:text-frost-soft mb-4">
                {row.description}
              </p>
              <ul class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] tracking-wide uppercase text-ink-mute dark:text-frost-mute">
                {row.tools.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </div>
        </li>
      ))}
      <li class="skill-row" aria-hidden="true"><span class="skill-rule block h-px"></span></li>
    </ol>
  </section>

  <!-- ─── Projects ──────────────────────────────────────────────────────── -->
  <section id="work" class="px-6 md:px-12 py-16 max-w-6xl mx-auto w-full">
    <!-- Section header: heading + gradient rule -->
    <div class="reveal mb-8">
      <div class="flex items-center gap-5">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink dark:text-frost">
          Projects
        </h2>
        <span class="section-rule flex-1 h-px" aria-hidden="true"></span>
      </div>
    </div>

    <!--
      Legend-as-filter: styled like a chart legend, wired as a filter.
      Clicking a category shows only that category's cards; counts on each
      chip are real. Without JS every card simply stays visible.
    -->
    <div class="reveal flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter projects by category">
      <button
        type="button"
        class="filter-chip font-mono text-[11px] tracking-wide uppercase rounded-full px-3.5 py-1.5"
        data-filter="all"
        aria-pressed="true"
      >
        All <span class="chip-count">{total}</span>
      </button>
      {CATEGORIES.map((c) => (
        <button
          type="button"
          class="filter-chip font-mono text-[11px] tracking-wide uppercase rounded-full px-3.5 py-1.5
                 inline-flex items-center gap-1.5"
          data-filter={c.id}
          aria-pressed="false"
          style={`--hue-l:${c.light}; --hue-d:${c.dark};`}
        >
          <span class="w-1.5 h-1.5 rounded-full chip-dot" aria-hidden="true"></span>
          {c.label} <span class="chip-count">{counts[c.id]}</span>
        </button>
      ))}
    </div>

    <!--
      Responsive grid: 1 col on mobile → 2 cols on md → 3 cols on lg.
      Cards stagger in as the grid scrolls into view.
    -->
    <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          status={project.data.status}
          category={project.data.category}
          tags={project.data.tags}
          image={project.data.image}
          imageFit={project.data.imageFit}
          liveUrl={project.data.liveUrl}
          githubUrl={project.data.githubUrl}
          detailId={project.data.detail ? `modal-${project.id}` : undefined}
          index={i}
        />
      ))}
    </div>
  </section>

  <!--
    Case-study modals — one per project that has deep-dive content, hidden
    until its card's "Case study" button opens it. Rendered outside the grid
    so the native <dialog> centres over the whole page.
  -->
  {projects
    .filter((project) => project.data.detail)
    .map((project) => (
      <ProjectModal
        id={`modal-${project.id}`}
        title={project.data.title}
        status={project.data.status}
        category={project.data.category}
        liveUrl={project.data.liveUrl}
        githubUrl={project.data.githubUrl}
        detail={project.data.detail!}
      />
    ))}

  <!-- ─── About ─────────────────────────────────────────────────────────── -->
  <section id="about" class="px-6 md:px-12 py-16 max-w-6xl mx-auto w-full">
    <div class="reveal mb-8">
      <div class="flex items-center gap-5">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink dark:text-frost">
          Background
        </h2>
        <span class="section-rule flex-1 h-px" aria-hidden="true"></span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-10">
      <!-- Bio copy with category-colored phrase highlights -->
      <div class="reveal space-y-5 text-ink-soft dark:text-frost-soft leading-relaxed max-w-2xl">
        <p>
          I'm a developer and data journalist based in Missouri. I build public-interest tools at
          the intersection of <span class="hl hl-civic">civic technology</span>,
          <span class="hl hl-data">data analysis</span>, and
          <span class="hl hl-apps">software engineering</span> — from redistricting transparency
          sites to political accountability trackers to iOS apps.
        </p>
        <p>
          I believe good software should be fair, open, and legible to the people it serves. The
          work here is a mix of production products, ongoing research, and
          <span class="hl hl-play">experiments that scratch my own itch</span>.
        </p>
      </div>

      <!-- Toolbox: three tight columns (Gestalt proximity — grouped = related) -->
      <div class="reveal grid grid-cols-3 gap-6" style="--stagger: 1;">
        {[
          { heading: 'Analyze', hueL: '#2358a0', hueD: '#4f86c6', items: ['Python', 'Pandas', 'SQL', 'Tableau'] },
          { heading: 'Build',   hueL: '#08846b', hueD: '#1aa886', items: ['React', 'Astro', 'Swift', 'FastAPI'] },
          { heading: 'Ship',    hueL: '#8794a1', hueD: '#8795a3', items: ['GitHub Actions', 'Cloudflare', 'Docker', 'Playwright'] },
        ].map((col) => (
          <div class="toolbox-col" style={`--hue-l:${col.hueL}; --hue-d:${col.hueD};`}>
            <h3 class="font-mono text-[11px] font-medium tracking-[0.2em] uppercase mb-3 toolbox-heading">
              {col.heading}
            </h3>
            <ul class="space-y-2">
              {col.items.map((item) => (
                <li class="flex items-center gap-2 text-sm text-ink-soft dark:text-frost-soft">
                  <span class="w-1 h-1 rounded-full toolbox-dot shrink-0" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Footer ────────────────────────────────────────────────────────── -->
  <footer class="px-6 md:px-12 pb-10 pt-4 max-w-6xl mx-auto w-full">
    <!--
      The divider IS a chart: a 100% stacked bar of the portfolio by
      category, using the same hues as everywhere else. Hover it for the
      breakdown; a visually-hidden caption spells it out for screen readers.
    -->
    <figure class="mb-8">
      <div
        class="flex h-1.5 rounded-full overflow-hidden gap-0.5"
        title={CATEGORIES.map((c) => `${c.label}: ${counts[c.id]}`).join(' · ')}
      >
        {CATEGORIES.map((c) => (
          <span
            class="footer-seg h-full"
            style={`--hue-l:${c.light}; --hue-d:${c.dark}; width:${(counts[c.id] / total) * 100}%;`}
          ></span>
        ))}
      </div>
      <figcaption class="sr-only">
        Portfolio by category: {CATEGORIES.map((c) => `${c.label} ${counts[c.id]}`).join(', ')}
      </figcaption>
    </figure>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="font-mono text-xs tracking-wide text-ink-mute dark:text-frost-mute">
        © 2026 Matt Snively · Built with Astro
      </p>
      <a
        href="mailto:mattsnively@gmail.com"
        class="font-mono text-xs tracking-wide text-ink-soft dark:text-frost-soft
               hover:text-cat-data dark:hover:text-cat-data-d transition-colors"
      >
        mattsnively@gmail.com
      </a>
    </div>
  </footer>
</Base>

<style>
  /* ── Nav links: underline slides in from the left on hover ─────────── */
  .nav-link {
    position: relative;
    color: theme('colors.ink.mute');
    transition: color 0.2s ease;
  }
  :global(.dark) .nav-link {
    color: theme('colors.frost.mute');
  }
  .nav-link:hover {
    color: theme('colors.ink.DEFAULT');
  }
  :global(.dark) .nav-link:hover {
    color: theme('colors.frost.DEFAULT');
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1.5px;
    background: linear-gradient(90deg, var(--brand-a), var(--brand-b));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* ── Theme-resolved accent: --hue picks the right surface step ─────── */
  .role-chip, .stat-tile, .filter-chip, .toolbox-col, .footer-seg {
    --hue: var(--hue-l);
  }
  :global(.dark) .role-chip,
  :global(.dark) .stat-tile,
  :global(.dark) .filter-chip,
  :global(.dark) .toolbox-col,
  :global(.dark) .footer-seg {
    --hue: var(--hue-d);
  }
  .role-dot, .chip-dot, .toolbox-dot { background: var(--hue); }
  .toolbox-heading { color: var(--hue); }
  .footer-seg { background: var(--hue); }

  /* ── Gradient ink: the signature panning gradient ───────────────────
     Shared by the hero name and the featured stat's number, so the page's
     two "full measures" visibly belong together. */
  .gradient-ink {
    background: var(--brand-grad);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-pan 9s ease-in-out infinite;
  }

  /* ── Primary CTA: gradient fill, lifts on hover ────────────────────── */
  .hero-cta {
    background: linear-gradient(120deg, #d62839, #b01e2e);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -6px rgba(214, 40, 57, 0.5);
  }

  /* ── Hero ───────────────────────────────────────────────────────────
     --fig-h is the portrait height (capped by svh so it fits the stage, and
     by vw so it never outgrows narrow windows). On md+ the headline is one
     row at head height: word 1 right-aligned, word 2 left-aligned, a gap the
     width of the head between them, so the portrait sits between the words
     instead of hiding letters. Mobile stacks the words above the portrait. */
  .hero { --fig-h: min(58svh, 120vw); }
  @media (min-width: 1280px) {
    .hero { --fig-h: min(86svh, 70vw); }
  }
  /* The photo is cropped at the thighs; fading the last 10% lets it dissolve
     into the page instead of ending in a hard edge when scrolled. */
  .hero-img {
    height: var(--fig-h);
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
  }
  /* Mobile: two zig-zag pairs ("HI … Y'ALL," / "I'M … MATT"). */
  .hero-title {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: space-between;
    font-size: clamp(2.75rem, 14vw, 7rem);
    line-height: 0.84;
    letter-spacing: -0.03em;
  }
  @media (min-width: 1280px) {
    .hero-title {
      /* Block top = portrait top + 7% of its height (just above the hairline). */
      top: calc(100% - var(--fig-h) * 0.93);
      height: calc(var(--fig-h) * 0.72);
      /* Four words step down the portrait, alternating sides like a staircase.
         Portrait is 0.552 as wide as tall; the head is ~0.5 of that width. */
      grid-template-columns: 1fr calc(var(--fig-h) * 0.3) 1fr;
      grid-template-rows: repeat(4, 1fr);
      justify-content: normal;
      align-items: center;
      font-size: min(10vw, calc(var(--fig-h) * 0.22));
      white-space: nowrap;
    }
    .hero-line:nth-child(1) { grid-area: 1 / 1; }
    .hero-line:nth-child(2) { grid-area: 2 / 3; padding-left: calc(var(--fig-h) * 0.04); }
    /* Lower rows sit beside the shoulders/torso, which are wider than the head. */
    .hero-line:nth-child(3) { grid-area: 3 / 1; padding-right: calc(var(--fig-h) * 0.16); }
    .hero-line:nth-child(4) { grid-area: 4 / 3; padding-left: calc(var(--fig-h) * 0.12); }
  }
  /* Overflow clip is the mask for the char slide-up; bottom padding keeps
     the line box from shaving the baseline. */
  .hero-line { overflow: hidden; padding-bottom: 0.04em; }
  .hero-line-accent { color: var(--brand-a); }

  /* Hidden start state for the entrance timeline. Gated on JS + motion so
     no-JS and reduced-motion visitors see everything; the delayed fade-in is
     a failsafe if the bundle never loads. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-hero-fade],
    :global(html.js) .hero-stage {
      opacity: 0;
      animation: fade-in 0.01s 2.5s forwards;
    }
  }

  /* ── Skills rows ────────────────────────────────────────────────────── */
  .skill-rule { background: theme('colors.day.200'); transform-origin: left; }
  :global(.dark) .skill-rule { background: theme('colors.night.700'); }
  .skill-num { color: var(--brand-a); }
  .skill-title {
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    /* Mask for the slide-up: clips top/bottom only, so an over-long title
       spills sideways instead of being cut off mid-letter. */
    clip-path: inset(0 -100vw);
    padding-bottom: 0.05em;
  }
  .skill-title { transition: translate 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .skill-title-inner { transition: color 0.25s ease; }
  @media (hover: hover) {
    /* The nudge sits on the mask wrapper: GSAP writes `translate: none` inline on
     the element it tweens (.skill-title-inner), which would override a hover
     rule placed there. */
    .skill-row:hover .skill-title { translate: 14px 0; }
    .skill-row:hover .skill-title-inner { color: var(--brand-a); }
  }
  /* Dimming only exists once the script has taken over (.skills-live), so a
     failed bundle or reduced motion never leaves rows greyed out. */
  .skills-live .skill-row { transition: opacity 0.4s ease; opacity: 0.32; }
  .skills-live .skill-row[data-active],
  .skills-live .skill-row:hover,
  .skills-live .skill-row:focus-within { opacity: 1; }

  /* Rotating slot: its content fades out, the metric swaps, then fades back */
  .kpi-rot-content {
    transition: opacity 0.35s ease;
  }
  .kpi-rotator.swapping .kpi-rot-content {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .kpi-rot-content {
      transition: none;
    }
  }

  /* ── Stat tiles: colored rule grows when the tile reveals ──────────── */
  .stat-rule {
    background: var(--hue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }
  .stat-tile.in .stat-rule {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-rule { transform: scaleX(1); }
  }

  /* Featured tile: an animated gradient border matching the hero name.
     Two-layer background trick — an opaque tinted fill clipped to the
     padding box sits over the panning gradient clipped to the border box,
     so only the 1px border ring shows the moving gradient. The single
     background-position animation pans both layers, but the fill layer is
     100% sized so only the gradient ring visibly moves. */
  .stat-featured {
    border: 1px solid transparent;
    background:
      linear-gradient(
        color-mix(in srgb, var(--brand-a) 7%, #ffffff),
        color-mix(in srgb, var(--brand-a) 7%, #ffffff)
      ) padding-box,
      var(--brand-grad) border-box;
    background-size: 100% 100%, 300% 100%;
    animation: gradient-pan 9s ease-in-out infinite;
  }
  :global(.dark) .stat-featured {
    background:
      linear-gradient(
        color-mix(in srgb, var(--brand-a) 9%, theme('colors.night.900')),
        color-mix(in srgb, var(--brand-a) 9%, theme('colors.night.900'))
      ) padding-box,
      var(--brand-grad) border-box;
    background-size: 100% 100%, 300% 100%;
  }
  .stat-kicker {
    color: var(--hue);
  }

  /* ── Section rules: hairline wearing the same panning gradient ──────
     Identical hues and timing to .gradient-ink; a mask keeps the old
     fade-out toward the right edge. */
  .section-rule {
    background: var(--brand-grad);
    background-size: 300% 100%;
    animation: gradient-pan 9s ease-in-out infinite;
    opacity: 0.55;
    mask-image: linear-gradient(90deg, black 0%, black 45%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, black 0%, black 45%, transparent 100%);
  }

  /* ── Filter chips (the legend) ─────────────────────────────────────── */
  .filter-chip {
    color: theme('colors.ink.soft');
    border: 1px solid theme('colors.day.200');
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  :global(.dark) .filter-chip {
    color: theme('colors.frost.soft');
    border-color: theme('colors.night.700');
  }
  .filter-chip:hover {
    border-color: var(--hue, theme('colors.day.300'));
    color: theme('colors.ink.DEFAULT');
  }
  :global(.dark) .filter-chip:hover {
    color: theme('colors.frost.DEFAULT');
  }
  /* Selected chip: tinted wash of its own hue + solid hue border */
  .filter-chip[aria-pressed='true'] {
    border-color: var(--hue, theme('colors.ink.DEFAULT'));
    color: theme('colors.ink.DEFAULT');
    background: color-mix(in srgb, var(--hue, #8b8894) 12%, transparent);
  }
  :global(.dark) .filter-chip[aria-pressed='true'] {
    color: theme('colors.frost.DEFAULT');
  }
  .chip-count {
    opacity: 0.55;
    margin-left: 2px;
  }

  /* ── About: phrase highlights — thick colored underlines ───────────── */
  .hl {
    font-weight: 500;
    color: inherit;
    box-shadow: inset 0 -0.45em 0 var(--hl);
  }
  .hl-data  { --hl: rgba(35, 88, 160, 0.22); }
  .hl-civic { --hl: rgba(214, 40, 57, 0.2); }
  .hl-apps  { --hl: rgba(8, 132, 107, 0.24); }
  .hl-play  { --hl: rgba(135, 148, 161, 0.28); }
  :global(.dark) .hl-data  { --hl: rgba(79, 134, 198, 0.3); }
  :global(.dark) .hl-civic { --hl: rgba(240, 82, 95, 0.28); }
  :global(.dark) .hl-apps  { --hl: rgba(26, 168, 134, 0.32); }
  :global(.dark) .hl-play  { --hl: rgba(135, 149, 163, 0.32); }
</style>

<!-- Theme toggle — reads/writes localStorage and flips the `dark` class -->
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>

<!--
  Hero motion. Entrance: headline characters slide up out of their line mask,
  the portrait rises in, flank text follows. Scroll: the two words drift apart
  and the portrait lags (scrubbed parallax). Pointer (fine pointers only): the
  words and portrait shift against each other for depth. All of it lives inside
  whenMotionOk, so reduced-motion visitors get the static layout.
-->
<script>
  import { gsap, whenMotionOk } from '../lib/motion';

  whenMotionOk(() => {
    gsap.set('[data-hero-fade], .hero-stage', { opacity: 1 });

    gsap
      .timeline({ defaults: { ease: 'power4.out' } })
      .from('.hero-char', { yPercent: 115, duration: 1.1, stagger: 0.05 })
      .from('.hero-img', { yPercent: 7, opacity: 0, scale: 1.04, duration: 1.3 }, 0.2)
      .from('[data-hero-flank] > *', { y: 24, opacity: 0, duration: 0.9, stagger: 0.08 }, 0.8);

    const scrub = { trigger: '#top', start: 'top top', end: 'bottom top', scrub: 0.6 };
    // Left-side words (even index) drift left, right-side words drift right.
    gsap.utils.toArray<HTMLElement>('.hero-line').forEach((el, i) => {
      gsap.to(el, { xPercent: i % 2 ? 12 : -12, ease: 'none', scrollTrigger: scrub });
    });
    gsap.to('.hero-figure', { yPercent: 6, ease: 'none', scrollTrigger: scrub });

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const hero = document.getElementById('top')!;
      const img = gsap.quickTo('.hero-img', 'x', { duration: 0.8, ease: 'power3.out' });
      const words = gsap.utils
        .toArray<HTMLElement>('.hero-line-inner')
        .map((el) => gsap.quickTo(el, 'x', { duration: 1, ease: 'power3.out' }));
      hero.addEventListener('pointermove', (e) => {
        const nx = e.clientX / window.innerWidth - 0.5; // -0.5 … 0.5
        img(nx * 18);
        words.forEach((move) => move(nx * -36));
      });
    }
  });
</script>

<!--
  Skills motion. Per row: rule draws left→right, title slides up out of its
  mask, body rises in (once, as the row enters). Separately, the row crossing
  the middle band of the viewport is marked data-active; CSS dims the others.
-->
<script>
  import { gsap, ScrollTrigger, whenMotionOk } from '../lib/motion';

  whenMotionOk(() => {
    const section = document.getElementById('skills');
    if (!section) return;
    section.classList.add('skills-live');

    section.querySelectorAll<HTMLElement>('.skill-row').forEach((row) => {
      const rule = row.querySelector('.skill-rule');
      const title = row.querySelector('.skill-title-inner');
      const body = row.querySelector('.skill-body');
      const num = row.querySelector('.skill-num');

      const tl = gsap.timeline({
        defaults: { ease: 'power4.out' },
        scrollTrigger: { trigger: row, start: 'top 85%', once: true },
      });
      tl.from(rule, { scaleX: 0, duration: 1.1, ease: 'power3.inOut' });
      if (title) tl.from(title, { yPercent: 110, duration: 0.9 }, 0.15);
      if (num) tl.from(num, { opacity: 0, x: -10, duration: 0.6 }, 0.25);
      if (body) tl.from(body, { y: 24, opacity: 0, duration: 0.8 }, 0.35);

      ScrollTrigger.create({
        trigger: row,
        start: 'top 62%',
        end: 'bottom 38%',
        onToggle: (self) => row.toggleAttribute('data-active', self.isActive),
      });
    });

    // Cleanup runs if the visitor flips reduced-motion mid-session.
    return () => section.classList.remove('skills-live');
  });
</script>

<!--
  Work-card motion. Cards enter in scroll-batched waves (rise, un-tilt, scale
  up, staggered); each screenshot drifts against its card while scrolling
  (parallax, cover images only — padded logos stay put); and a filter change
  replays a short re-entry on whatever is now visible. Reduced motion leaves
  the grid static.
-->
<script>
  import { gsap, ScrollTrigger, whenMotionOk } from '../lib/motion';

  whenMotionOk(() => {
    const grid = document.getElementById('project-grid');
    if (!grid) return;
    const cards = gsap.utils.toArray<HTMLElement>('#project-grid .project-card');

    // Alternate the entry tilt so a row of three fans out instead of marching in step.
    gsap.set(cards, {
      opacity: 0,
      y: 80,
      scale: 0.95,
      rotation: (i: number) => (i % 2 === 0 ? -2 : 2),
      transformOrigin: '50% 100%',
    });

    ScrollTrigger.batch(cards, {
      start: 'top 90%',
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1, y: 0, scale: 1, rotation: 0,
          duration: 1, ease: 'power3.out', stagger: 0.12, overwrite: true,
        }),
    });

    // Parallax: oversize the image slightly so it has room to travel.
    cards.forEach((card) => {
      const img = card.querySelector<HTMLElement>('.card-img');
      if (!img || img.classList.contains('object-contain')) return;
      gsap.set(img, { scale: 1.14 });
      gsap.fromTo(
        img,
        { yPercent: -5 },
        {
          yPercent: 5, ease: 'none',
          scrollTrigger: { trigger: card, start: 'top bottom', end: 'bottom top', scrub: true },
        },
      );
    });

    // Filter change: the legend script toggles .hidden first; replay on what's left.
    const onFilter = () =>
      requestAnimationFrame(() => {
        const visible = cards.filter((c) => !c.classList.contains('hidden'));
        gsap.fromTo(
          visible,
          { opacity: 0, y: 36, scale: 0.97, rotation: 0 },
          { opacity: 1, y: 0, scale: 1, duration: 0.7, ease: 'power3.out', stagger: 0.07, overwrite: true },
        );
        ScrollTrigger.refresh();
      });
    const chips = document.querySelectorAll('.filter-chip');
    chips.forEach((c) => c.addEventListener('click', onFilter));

    return () => chips.forEach((c) => c.removeEventListener('click', onFilter));
  });
</script>

<!--
  Stats strip — count the pinned measure up when the strip scrolls into view,
  then rotate the single slot through the project-sourced pool. Reduced motion
  holds on the first metric.
-->
<script>
  interface Kpi { value: number; suffix: string; label: string; hueL: string; hueD: string }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const panel = document.querySelector<HTMLElement>('.kpi-panel');
  const pinnedNum = document.querySelector<HTMLElement>('.kpi-pinned-num');
  const rotator = document.querySelector<HTMLElement>('.kpi-rotator');
  const rotNum = document.querySelector<HTMLElement>('.kpi-rot-num');
  const rotSuffix = document.querySelector<HTMLElement>('.kpi-rot-suffix');
  const rotLabel = document.querySelector<HTMLElement>('.kpi-rot-label');

  const poolEl = document.getElementById('kpi-pool');
  const pool: Kpi[] = poolEl ? JSON.parse(poolEl.textContent || '[]') : [];

  /** Count 0 → target over ~1.1s; jumps straight to the value under reduced motion */
  function countUp(el: HTMLElement, target: number) {
    if (reduceMotion || !Number.isFinite(target)) {
      el.textContent = target.toLocaleString();
      return;
    }
    const duration = 1100;
    const start = performance.now();
    function tick(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3); // cubic ease-out
      el.textContent = Math.round(target * eased).toLocaleString();
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  let idx = 0;
  /** Paint pool[i] into the rotating slot: hue, suffix, label, and count-up */
  function applyKpi(i: number) {
    const k = pool[i];
    if (!k || !rotator || !rotNum || !rotSuffix || !rotLabel) return;
    rotator.style.setProperty('--hue-l', k.hueL);
    rotator.style.setProperty('--hue-d', k.hueD);
    rotSuffix.textContent = k.suffix;
    rotLabel.textContent = k.label;
    countUp(rotNum, k.value);
  }

  function startRotation() {
    window.setInterval(() => {
      rotator?.classList.add('swapping'); // fade content out
      window.setTimeout(() => {
        idx = (idx + 1) % pool.length;
        applyKpi(idx);
        rotator?.classList.remove('swapping'); // fade the new metric in
      }, 350);
    }, 4200);
  }

  function revealPanel() {
    if (pinnedNum) countUp(pinnedNum, Number(pinnedNum.dataset.target ?? '0'));
    if (pool.length) applyKpi(0);
    if (!reduceMotion && pool.length > 1) startRotation();
  }

  // Start counting when the strip first scrolls into view (it sits below the fold).
  if (panel) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        revealPanel();
      }
    }, { threshold: 0.4 });
    io.observe(panel);
  }
</script>

<!--
  Legend filter — clicking a chip shows only that category's cards.
  aria-pressed tracks the active chip; "All" restores everything.
-->
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid [data-category]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      // Exactly one chip is pressed at a time
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      // Show matching cards, hide the rest
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
